<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<VBox spacing="15" style="-fx-padding: 15;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.library.controller.NotificationsController">
    
    <!-- Notifications Summary -->
    <HBox spacing="20" style="-fx-background-color: #ecf0f1; -fx-padding: 15; -fx-border-radius: 5;">
        <VBox spacing="5">
            <Label text="Critical Alerts" style="-fx-font-weight: bold;"/>
            <Label fx:id="criticalAlertsLabel" text="0" style="-fx-font-size: 18; -fx-text-fill: #e74c3c;"/>
        </VBox>
        <VBox spacing="5">
            <Label text="Warnings" style="-fx-font-weight: bold;"/>
            <Label fx:id="warningsLabel" text="0" style="-fx-font-size: 18; -fx-text-fill: #f39c12;"/>
        </VBox>
        <VBox spacing="5">
            <Label text="Info Messages" style="-fx-font-weight: bold;"/>
            <Label fx:id="infoMessagesLabel" text="0" style="-fx-font-size: 18; -fx-text-fill: #3498db;"/>
        </VBox>
        <VBox spacing="5">
            <Label text="Total Unread" style="-fx-font-weight: bold;"/>
            <Label fx:id="totalUnreadLabel" text="0" style="-fx-font-size: 18; -fx-text-fill: #2c3e50;"/>
        </VBox>
    </HBox>

    <!-- Filters -->
    <HBox spacing="15" style="-fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-padding: 10;">
        <Label text="Filters:" style="-fx-font-weight: bold;"/>
        
        <ComboBox fx:id="alertTypeFilter" prefWidth="150" onAction="#applyFilters">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="All"/>
                    <String fx:value="Overdue Books"/>
                    <String fx:value="High Fines"/>
                    <String fx:value="Low Inventory"/>
                    <String fx:value="System Alerts"/>
                    <String fx:value="User Activity"/>
                </FXCollections>
            </items>
        </ComboBox>

        <ComboBox fx:id="severityFilter" prefWidth="150" onAction="#applyFilters">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="All"/>
                    <String fx:value="Critical"/>
                    <String fx:value="Warning"/>
                    <String fx:value="Info"/>
                </FXCollections>
            </items>
        </ComboBox>

        <ComboBox fx:id="branchFilter" prefWidth="150" onAction="#applyFilters"/>

        <Button text="Clear All Notifications" onAction="#clearAllNotifications"/>
        <Button text="Refresh" onAction="#refreshNotifications"/>
    </HBox>

    <!-- Tab View for Different Alert Types -->
    <TabPane tabClosingPolicy="UNAVAILABLE">
        
        <!-- Overdue Books Tab -->
        <Tab text="Overdue Books" closable="false">
            <VBox spacing="10" style="-fx-padding: 10;">
                <Label text="Books Overdue for More Than 5 Days" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
                <TableView fx:id="overdueTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn text="Accession No." prefWidth="100" fx:id="overdueAccColumn"/>
                        <TableColumn text="Book Title" prefWidth="150" fx:id="overdueBookColumn"/>
                        <TableColumn text="Member" prefWidth="120" fx:id="overdueMemberColumn"/>
                        <TableColumn text="Branch" prefWidth="100" fx:id="overdueBranchColumn"/>
                        <TableColumn text="Issue Date" prefWidth="100" fx:id="overdueIssueColumn"/>
                        <TableColumn text="Days Overdue" prefWidth="100" fx:id="overdueDaysColumn"/>
                        <TableColumn text="Expected Fine" prefWidth="100" fx:id="overdueExpectedFineColumn"/>
                    </columns>
                </TableView>
                <Button text="Mark as Pending" onAction="#markOverduePending"/>
                <Button text="Send Reminder Email" onAction="#sendReminderEmail"/>
            </VBox>
        </Tab>

        <!-- High Fines Tab -->
        <Tab text="High Fines Pending" closable="false">
            <VBox spacing="10" style="-fx-padding: 10;">
                <Label text="Members with Fines Exceeding Rs. 500" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
                <TableView fx:id="highFinesTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn text="Member ID" prefWidth="100" fx:id="finesMemberColumn"/>
                        <TableColumn text="Member Name" prefWidth="150" fx:id="finesMemberNameColumn"/>
                        <TableColumn text="Branch" prefWidth="100" fx:id="finesBranchColumn"/>
                        <TableColumn text="Total Fine Amount" prefWidth="130" fx:id="finesTotalColumn"/>
                        <TableColumn text="Number of Overdue Books" prefWidth="150" fx:id="finesCountColumn"/>
                        <TableColumn text="Last Update" prefWidth="130" fx:id="finesDateColumn"/>
                    </columns>
                </TableView>
                <Button text="Send Payment Reminder" onAction="#sendPaymentReminder"/>
                <Button text="Generate Fine Notice" onAction="#generateFineNotice"/>
            </VBox>
        </Tab>

        <!-- Low Inventory Tab -->
        <Tab text="Low Inventory Alert" closable="false">
            <VBox spacing="10" style="-fx-padding: 10;">
                <Label text="Books with Available Copies Below 3" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
                <TableView fx:id="lowInventoryTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn text="Book Title" prefWidth="200" fx:id="invBookColumn"/>
                        <TableColumn text="Category" prefWidth="100" fx:id="invCategoryColumn"/>
                        <TableColumn text="Total Copies" prefWidth="100" fx:id="invTotalColumn"/>
                        <TableColumn text="Available Copies" prefWidth="130" fx:id="invAvailableColumn"/>
                        <TableColumn text="Currently Issued" prefWidth="130" fx:id="invIssuedColumn"/>
                    </columns>
                </TableView>
                <Button text="Request Purchase" onAction="#requestPurchase"/>
            </VBox>
        </Tab>

        <!-- System Alerts Tab -->
        <Tab text="System Alerts" closable="false">
            <VBox spacing="10" style="-fx-padding: 10;">
                <Label text="System Health &amp; Error Alerts" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
                <TableView fx:id="systemAlertsTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn text="Timestamp" prefWidth="150" fx:id="sysTimeColumn"/>
                        <TableColumn text="Severity" prefWidth="100" fx:id="sysSeverityColumn"/>
                        <TableColumn text="Alert Type" prefWidth="150" fx:id="sysTypeColumn"/>
                        <TableColumn text="Message" prefWidth="300" fx:id="sysMessageColumn"/>
                        <TableColumn text="Status" prefWidth="80" fx:id="sysStatusColumn"/>
                    </columns>
                </TableView>
                <Button text="Resolve Alert" onAction="#resolveAlert"/>
            </VBox>
        </Tab>

        <!-- User Activity Tab -->
        <Tab text="User Activity" closable="false">
            <VBox spacing="10" style="-fx-padding: 10;">
                <Label text="Suspicious or Notable User Activities" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
                <TableView fx:id="userActivityTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn text="Timestamp" prefWidth="150" fx:id="actTimeColumn"/>
                        <TableColumn text="User" prefWidth="120" fx:id="actUserColumn"/>
                        <TableColumn text="Activity Type" prefWidth="150" fx:id="actTypeColumn"/>
                        <TableColumn text="Details" prefWidth="300" fx:id="actDetailsColumn"/>
                        <TableColumn text="Branch" prefWidth="100" fx:id="actBranchColumn"/>
                    </columns>
                </TableView>
                <Button text="View Full Audit Log" onAction="#viewFullAuditLog"/>
            </VBox>
        </Tab>
    </TabPane>

    <!-- Notification Settings -->
    <VBox spacing="10" style="-fx-border-color: #3498db; -fx-border-radius: 5; -fx-padding: 10;">
        <Label text="Notification Preferences" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
        <HBox spacing="30">
            <CheckBox fx:id="overdueCheckbox" text="Notify on Overdue Books" selected="true"/>
            <CheckBox fx:id="fineCheckbox" text="Notify on High Fines" selected="true"/>
            <CheckBox fx:id="inventoryCheckbox" text="Notify on Low Inventory" selected="true"/>
            <CheckBox fx:id="systemCheckbox" text="Notify on System Alerts" selected="true"/>
            <Button text="Save Preferences" onAction="#savePreferences"/>
        </HBox>
    </VBox>

    <!-- Export Notifications -->
    <HBox spacing="10">
        <Button text="Export Notifications as CSV" onAction="#exportNotifications"/>
        <Button text="Generate Notification Report" onAction="#generateNotificationReport"/>
    </HBox>
</VBox>
