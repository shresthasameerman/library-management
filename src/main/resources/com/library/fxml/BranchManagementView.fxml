<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" style="-fx-padding: 15;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.library.controller.BranchManagementController">
    
    <!-- Action Buttons -->
    <HBox spacing="10" style="-fx-padding: 10; -fx-background-color: #ecf0f1; -fx-border-radius: 5;">
        <Button text="+ Add New Branch" onAction="#openAddBranchDialog" style="-fx-font-size: 11; -fx-padding: 8;"/>
        <Button text="Edit Selected" onAction="#editSelectedBranch" style="-fx-font-size: 11; -fx-padding: 8;"/>
        <Button text="Delete Selected" onAction="#deleteSelectedBranch" style="-fx-font-size: 11; -fx-padding: 8; -fx-text-fill: #e74c3c;"/>
        <Button text="Refresh" onAction="#refreshBranchList" style="-fx-font-size: 11; -fx-padding: 8;"/>
    </HBox>

    <!-- Branches Table -->
    <Label text="All Branches" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
    <TableView fx:id="branchesTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn text="Branch ID" prefWidth="80" fx:id="branchIdColumn"/>
            <TableColumn text="Branch Name" prefWidth="150" fx:id="branchNameColumn"/>
            <TableColumn text="Location" prefWidth="150" fx:id="locationColumn"/>
            <TableColumn text="Total Books" prefWidth="100" fx:id="totalBooksColumn"/>
            <TableColumn text="Available Books" prefWidth="120" fx:id="availableBooksColumn"/>
            <TableColumn text="Total Members" prefWidth="110" fx:id="totalMembersColumn"/>
            <TableColumn text="Admin" prefWidth="120" fx:id="adminColumn"/>
            <TableColumn text="Active" prefWidth="80" fx:id="activeColumn"/>
        </columns>
    </TableView>

    <!-- Branch Details Panel -->
    <VBox spacing="10" style="-fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-padding: 10;">
        <Label text="Selected Branch Details" style="-fx-font-weight: bold; -fx-font-size: 13;"/>
        <GridPane hgap="20" vgap="10">
            <columnConstraints>
                <ColumnConstraints prefWidth="150"/>
                <ColumnConstraints prefWidth="200" hgrow="ALWAYS"/>
                <ColumnConstraints prefWidth="150"/>
                <ColumnConstraints prefWidth="200" hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="Branch Name:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
            <Label fx:id="detailBranchName" text="--" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Location:" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
            <Label fx:id="detailLocation" text="--" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

            <Label text="Created Date:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
            <Label fx:id="detailCreatedDate" text="--" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Assigned Admin:" GridPane.columnIndex="2" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
            <HBox spacing="10" GridPane.columnIndex="3" GridPane.rowIndex="1">
                <Label fx:id="detailAdmin" text="--"/>
                <Button text="Reassign" onAction="#reassignAdmin"/>
            </HBox>

            <Label text="Performance Metrics:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
            <GridPane GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="2" hgap="20" vgap="5">
                <columnConstraints>
                    <ColumnConstraints prefWidth="150"/>
                    <ColumnConstraints prefWidth="150"/>
                    <ColumnConstraints prefWidth="150"/>
                </columnConstraints>
                <Label text="Books Issued This Month: " GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Label fx:id="metricIssued" text="0" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
                
                <Label text="Books Returned This Month: " GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label fx:id="metricReturned" text="0" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
                
                <Label text="Fines Collected This Month: " GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <Label fx:id="metricFines" text="Rs. 0" GridPane.columnIndex="2" GridPane.rowIndex="1" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
            </GridPane>
        </GridPane>
    </VBox>

    <!-- Assign Admin Section -->
    <VBox spacing="10" style="-fx-border-color: #f39c12; -fx-border-radius: 5; -fx-padding: 10;">
        <Label text="Manage Branch Admins" style="-fx-font-weight: bold; -fx-font-size: 13;"/>
        <HBox spacing="10">
            <ComboBox fx:id="adminAssignCombo" prefWidth="250" promptText="Select admin to assign..."/>
            <Button text="Assign" onAction="#assignAdminToBranch"/>
            <Button text="Remove" onAction="#removeAdminFromBranch"/>
        </HBox>
    </VBox>

    <!-- Export Buttons -->
    <HBox spacing="10">
        <Button text="Export Branch List" onAction="#exportBranchList"/>
        <Button text="Export Performance Report" onAction="#exportPerformanceReport"/>
    </HBox>
</VBox>
