<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<BorderPane
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.library.controller.DashboardController"
    fx:id="mainPane"
    prefWidth="1100" prefHeight="680"
    style="-fx-background-color: #eef1fb;">

    <!-- ══════════════ SIDEBAR ══════════════ -->
    <left>
        <VBox styleClass="sidebar" prefWidth="230" spacing="0">

            <!-- Brand -->
            <VBox style="-fx-padding: 28 20 20 20; -fx-spacing: 6;
                         -fx-background-color: #141428;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="📚" style="-fx-font-size: 26px;"/>
                    <VBox spacing="1">
                        <Label text="The British"
                               style="-fx-font-size: 14px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: white;"/>
                        <Label text="College Library"
                               style="-fx-font-size: 11px;
                                      -fx-text-fill: #7c8db5;"/>
                    </VBox>
                </HBox>
            </VBox>

            <Separator style="-fx-background-color: #252545;"/>
            <Region prefHeight="12"/>

            <Label text="MAIN MENU"
                   style="-fx-text-fill: #4a5568;
                          -fx-font-size: 10px;
                          -fx-font-weight: bold;
                          -fx-padding: 0 0 6 24;"/>

            <Button fx:id="btnDashboard"
                    text="🏠   Dashboard"
                    styleClass="nav-button"
                    onAction="#showDashboard"/>
            <Button fx:id="btnBooks"
                    text="📖   Books"
                    styleClass="nav-button"
                    onAction="#showBooks"/>
            <Button fx:id="btnMembers"
                    text="👥   Members"
                    styleClass="nav-button"
                    onAction="#showMembers"/>
            <Button fx:id="btnIssueReturn"
                    text="🔄   Issue / Return"
                    styleClass="nav-button"
                    onAction="#showIssueReturn"/>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- User Profile -->
            <VBox style="-fx-background-color: #252545;
                         -fx-padding: 16 20 16 20; -fx-spacing: 8;">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <StackPane>
                        <Circle radius="20" fill="#4361ee"/>
                        <Label fx:id="avatarLabel" text="A"
                               style="-fx-text-fill: white;
                                      -fx-font-weight: bold;
                                      -fx-font-size: 16px;"/>
                    </StackPane>
                    <VBox spacing="2">
                        <Label fx:id="welcomeLabel" text="Admin"
                               style="-fx-text-fill: white;
                                      -fx-font-size: 13px;
                                      -fx-font-weight: bold;"/>
                        <Label fx:id="roleLabel" text="ADMIN"
                               style="-fx-text-fill: #4361ee;
                                      -fx-font-size: 10px;
                                      -fx-font-weight: bold;"/>
                    </VBox>
                </HBox>
            </VBox>

            <Button text="🚪   Logout"
                    styleClass="nav-button"
                    style="-fx-text-fill: #e63946;
                           -fx-background-color: #1a1a2e;"
                    onAction="#handleLogout"/>
        </VBox>
    </left>

    <!-- ══════════════ MAIN CONTENT ══════════════ -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: #eef1fb;
                           -fx-background: #eef1fb;">
            <content>
                <VBox spacing="22"
                      style="-fx-padding: 28;
                             -fx-background-color: #eef1fb;">

                    <!-- ── TOP HEADER BAR ──────────────────────── -->
                    <HBox alignment="CENTER_LEFT" spacing="12"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 14;
                                 -fx-padding: 16 24 16 24;
                                 -fx-effect: dropshadow(gaussian,
                                   rgba(67,97,238,0.07),14,0,0,4);">
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label fx:id="greetingLabel"
                                   text="Good Morning! 👋"
                                   style="-fx-font-size: 22px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #1a1a2e;"/>
                            <Label text="The British College — Library Overview"
                                   style="-fx-font-size: 12px;
                                          -fx-text-fill: #a0aec0;"/>
                        </VBox>
                        <Label fx:id="dateLabel" text="Today"
                               style="-fx-font-size: 13px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #4361ee;
                                      -fx-background-color: #eef1fb;
                                      -fx-background-radius: 8;
                                      -fx-padding: 6 16 6 16;
                                      -fx-border-color: #c5cef7;
                                      -fx-border-radius: 8;"/>
                    </HBox>

                    <!-- ── STAT CARDS ──────────────────────────── -->
                    <HBox spacing="16">

                        <!-- Total Books — Blue filled -->
                        <VBox HBox.hgrow="ALWAYS" spacing="14"
                              style="-fx-background-color: #4361ee;
                                     -fx-background-radius: 16;
                                     -fx-padding: 24;
                                     -fx-effect: dropshadow(gaussian,
                                       rgba(67,97,238,0.45),20,0,0,8);">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="📚"
                                       style="-fx-font-size: 22px;"/>
                                <Label text="TOTAL BOOKS"
                                       style="-fx-font-size: 10px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: rgba(255,255,255,0.7);
                                              -fx-letter-spacing: 1;"/>
                            </HBox>
                            <Label fx:id="totalBooksLabel" text="0"
                                   style="-fx-font-size: 44px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: white;"/>
                            <Label text="in collection"
                                   style="-fx-font-size: 11px;
                                          -fx-text-fill: rgba(255,255,255,0.55);"/>
                        </VBox>

                        <!-- Members -->
                        <VBox HBox.hgrow="ALWAYS" spacing="14"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 16;
                                     -fx-padding: 24;
                                     -fx-effect: dropshadow(gaussian,
                                       rgba(67,97,238,0.08),16,0,0,4);">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="👥"
                                       style="-fx-font-size: 22px;"/>
                                <Label text="MEMBERS"
                                       style="-fx-font-size: 10px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #a0aec0;
                                              -fx-letter-spacing: 1;"/>
                            </HBox>
                            <Label fx:id="totalMembersLabel" text="0"
                                   style="-fx-font-size: 44px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #1a1a2e;"/>
                            <Label text="registered"
                                   style="-fx-font-size: 11px;
                                          -fx-text-fill: #c0c8e0;"/>
                        </VBox>

                        <!-- Issued -->
                        <VBox HBox.hgrow="ALWAYS" spacing="14"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 16;
                                     -fx-padding: 24;
                                     -fx-effect: dropshadow(gaussian,
                                       rgba(67,97,238,0.08),16,0,0,4);">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="🔄"
                                       style="-fx-font-size: 22px;"/>
                                <Label text="ISSUED"
                                       style="-fx-font-size: 10px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #a0aec0;
                                              -fx-letter-spacing: 1;"/>
                            </HBox>
                            <Label fx:id="issuedBooksLabel" text="0"
                                   style="-fx-font-size: 44px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #1a1a2e;"/>
                            <Label text="currently out"
                                   style="-fx-font-size: 11px;
                                          -fx-text-fill: #c0c8e0;"/>
                        </VBox>

                        <!-- Overdue — Red accent -->
                        <VBox HBox.hgrow="ALWAYS" spacing="14"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 16;
                                     -fx-padding: 24;
                                     -fx-effect: dropshadow(gaussian,
                                       rgba(230,57,70,0.15),16,0,0,4);
                                     -fx-border-color: #e63946;
                                     -fx-border-width: 0 0 0 4;
                                     -fx-border-radius: 16;">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="⚠️"
                                       style="-fx-font-size: 22px;"/>
                                <Label text="OVERDUE"
                                       style="-fx-font-size: 10px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #e63946;
                                              -fx-letter-spacing: 1;"/>
                            </HBox>
                            <Label fx:id="overdueLabel" text="0"
                                   style="-fx-font-size: 44px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #e63946;"/>
                            <Label text="need attention"
                                   style="-fx-font-size: 11px;
                                          -fx-text-fill: #f0a0a5;"/>
                        </VBox>

                    </HBox>

                    <!-- ── CHARTS ROW ──────────────────────────── -->
                    <HBox spacing="16">

                        <!-- Monthly Bar Chart -->
                        <VBox spacing="12" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 16;
                                     -fx-padding: 22;
                                     -fx-effect: dropshadow(gaussian,
                                       rgba(67,97,238,0.07),14,0,0,4);">
                            <HBox alignment="CENTER_LEFT">
                                <VBox HBox.hgrow="ALWAYS" spacing="2">
                                    <Label text="📊  Monthly Activity"
                                           style="-fx-font-size: 14px;
                                                  -fx-font-weight: bold;
                                                  -fx-text-fill: #1a1a2e;"/>
                                    <Label text="Issues vs Returns — Last 6 months"
                                           style="-fx-font-size: 11px;
                                                  -fx-text-fill: #a0aec0;"/>
                                </VBox>
                            </HBox>
                            <Separator/>
                            <javafx.scene.chart.BarChart
                                fx:id="monthlyBarChart"
                                prefHeight="220"
                                legendVisible="true"
                                animated="true"
                                style="-fx-background-color: transparent;">
                                <xAxis>
                                    <javafx.scene.chart.CategoryAxis/>
                                </xAxis>
                                <yAxis>
                                    <javafx.scene.chart.NumberAxis
                                        autoRanging="true"/>
                                </yAxis>
                            </javafx.scene.chart.BarChart>
                        </VBox>

                        <!-- Right column: 2 small charts -->
                        <VBox spacing="16" prefWidth="310">

                            <!-- Category Pie -->
                            <VBox spacing="10"
                                  style="-fx-background-color: white;
                                         -fx-background-radius: 16;
                                         -fx-padding: 20;
                                         -fx-effect: dropshadow(gaussian,
                                           rgba(67,97,238,0.07),14,0,0,4);">
                                <Label text="📚  Books by Category"
                                       style="-fx-font-size: 13px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #1a1a2e;"/>
                                <Separator/>
                                <javafx.scene.chart.PieChart
                                    fx:id="categoryPieChart"
                                    prefHeight="160"
                                    legendVisible="false"
                                    labelsVisible="true"
                                    animated="true"
                                    style="-fx-background-color: transparent;"/>
                            </VBox>

                            <!-- Member Type Pie -->
                            <VBox spacing="10"
                                  style="-fx-background-color: white;
                                         -fx-background-radius: 16;
                                         -fx-padding: 20;
                                         -fx-effect: dropshadow(gaussian,
                                           rgba(67,97,238,0.07),14,0,0,4);">
                                <Label text="👥  Member Types"
                                       style="-fx-font-size: 13px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #1a1a2e;"/>
                                <Separator/>
                                <HBox spacing="12" alignment="CENTER">
                                    <javafx.scene.chart.PieChart
                                        fx:id="memberPieChart"
                                        prefHeight="100"
                                        prefWidth="120"
                                        legendVisible="false"
                                        labelsVisible="false"
                                        animated="true"
                                        style="-fx-background-color: transparent;"/>
                                    <VBox spacing="10" alignment="CENTER_LEFT">
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <Circle radius="6" fill="#4361ee"/>
                                            <Label text="Students"
                                                   style="-fx-font-size: 12px;
                                                          -fx-text-fill: #4a5568;"
                                                   HBox.hgrow="ALWAYS"/>
                                            <Label fx:id="studentCountLabel"
                                                   text="0"
                                                   style="-fx-font-weight: bold;
                                                          -fx-text-fill: #4361ee;
                                                          -fx-font-size: 14px;"/>
                                        </HBox>
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <Circle radius="6" fill="#f77f00"/>
                                            <Label text="Staff"
                                                   style="-fx-font-size: 12px;
                                                          -fx-text-fill: #4a5568;"
                                                   HBox.hgrow="ALWAYS"/>
                                            <Label fx:id="staffCountLabel"
                                                   text="0"
                                                   style="-fx-font-weight: bold;
                                                          -fx-text-fill: #f77f00;
                                                          -fx-font-size: 14px;"/>
                                        </HBox>
                                    </VBox>
                                </HBox>
                            </VBox>

                        </VBox>
                    </HBox>

                    <!-- ── BOTTOM ROW: Actions + Status + Reports ── -->
                    <HBox spacing="16">

                        <!-- Quick Actions -->
                        <VBox spacing="12" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 16;
                                     -fx-padding: 22;
                                     -fx-effect: dropshadow(gaussian,
                                       rgba(67,97,238,0.07),14,0,0,4);">
                            <Label text="⚡  Quick Actions"
                                   style="-fx-font-size: 14px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #1a1a2e;"/>
                            <Separator/>
                            <HBox spacing="10">
                                <Button text="➕  Add Book"
                                        prefHeight="44"
                                        HBox.hgrow="ALWAYS"
                                        maxWidth="Infinity"
                                        styleClass="btn-primary"
                                        onAction="#showBooks"/>
                                <Button text="👤  Add Member"
                                        prefHeight="44"
                                        HBox.hgrow="ALWAYS"
                                        maxWidth="Infinity"
                                        style="-fx-background-color: #eef1fb;
                                               -fx-text-fill: #4361ee;
                                               -fx-font-weight: bold;
                                               -fx-font-size: 13px;
                                               -fx-background-radius: 8;
                                               -fx-cursor: hand;"
                                        onAction="#showMembers"/>
                            </HBox>
                            <HBox spacing="10">
                                <Button text="📤  Issue Book"
                                        prefHeight="44"
                                        HBox.hgrow="ALWAYS"
                                        maxWidth="Infinity"
                                        style="-fx-background-color: #eef1fb;
                                               -fx-text-fill: #4361ee;
                                               -fx-font-weight: bold;
                                               -fx-font-size: 13px;
                                               -fx-background-radius: 8;
                                               -fx-cursor: hand;"
                                        onAction="#showIssueReturn"/>
                                <Button text="📥  Return Book"
                                        prefHeight="44"
                                        HBox.hgrow="ALWAYS"
                                        maxWidth="Infinity"
                                        style="-fx-background-color: #fff0f1;
                                               -fx-text-fill: #e63946;
                                               -fx-font-weight: bold;
                                               -fx-font-size: 13px;
                                               -fx-background-radius: 8;
                                               -fx-cursor: hand;"
                                        onAction="#showIssueReturn"/>
                            </HBox>
                            <HBox spacing="10" fx:id="superAdminActionsRow">
                                <Button fx:id="btnManageBranches"
                                        text="🏢  Manage Branches"
                                        prefHeight="44"
                                        HBox.hgrow="ALWAYS"
                                        maxWidth="Infinity"
                                        style="-fx-background-color: #eef1fb;
                                               -fx-text-fill: #1a1a2e;
                                               -fx-font-weight: bold;
                                               -fx-font-size: 13px;
                                               -fx-background-radius: 8;
                                               -fx-cursor: hand;"
                                        onAction="#handleManageBranches"/>
                                <Button fx:id="btnManageLibrarians"
                                        text="🧑‍💼  Manage Librarians"
                                        prefHeight="44"
                                        HBox.hgrow="ALWAYS"
                                        maxWidth="Infinity"
                                        style="-fx-background-color: #eef1fb;
                                               -fx-text-fill: #1a1a2e;
                                               -fx-font-weight: bold;
                                               -fx-font-size: 13px;
                                               -fx-background-radius: 8;
                                               -fx-cursor: hand;"
                                        onAction="#handleManageLibrarians"/>
                            </HBox>
                            <Button fx:id="btnOnboarding"
                                    text="🚀  Quick Start Wizard"
                                    prefHeight="44"
                                    maxWidth="Infinity"
                                    style="-fx-background-color: #2dc653;
                                           -fx-text-fill: white;
                                           -fx-font-weight: bold;
                                           -fx-font-size: 13px;
                                           -fx-background-radius: 8;
                                           -fx-cursor: hand;"
                                    onAction="#handleOnboardingWizard"/>
                            <Button fx:id="btnSystemSummary"
                                    text="🌐  System-Wide Branch Summary"
                                    prefHeight="42"
                                    maxWidth="Infinity"
                                    style="-fx-background-color: #141428;
                                           -fx-text-fill: white;
                                           -fx-font-weight: bold;
                                           -fx-font-size: 12px;
                                           -fx-background-radius: 8;
                                           -fx-cursor: hand;"
                                    onAction="#handleSystemSummary"/>
                        </VBox>

                        <!-- System Status -->
                        <VBox spacing="12" prefWidth="200"
                              style="-fx-background-color: #1a1a2e;
                                     -fx-background-radius: 16;
                                     -fx-padding: 22;">
                            <Label text="📡  Status"
                                   style="-fx-font-size: 13px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: white;"/>
                            <Separator style="-fx-background-color: #252545;"/>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Circle radius="5" fill="#2dc653"/>
                                <Label text="System Online"
                                       style="-fx-text-fill: #a0aec0;
                                              -fx-font-size: 12px;"/>
                            </HBox>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Circle radius="5" fill="#4361ee"/>
                                <Label text="DB Connected"
                                       style="-fx-text-fill: #a0aec0;
                                              -fx-font-size: 12px;"/>
                            </HBox>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Circle radius="5" fill="#4361ee"/>
                                <Label text="Offline Mode"
                                       style="-fx-text-fill: #a0aec0;
                                              -fx-font-size: 12px;"/>
                            </HBox>
                            <Separator style="-fx-background-color: #252545;"/>
                            <Label text="Fine Rate"
                                   style="-fx-text-fill: #a0aec0;
                                          -fx-font-size: 11px;"/>
                            <Label text="Rs. 5 / day"
                                   style="-fx-text-fill: #4361ee;
                                          -fx-font-size: 18px;
                                          -fx-font-weight: bold;"/>
                        </VBox>

                        <!-- Reports -->
                        <VBox spacing="10" prefWidth="260"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 16;
                                     -fx-padding: 22;
                                     -fx-effect: dropshadow(gaussian,
                                       rgba(67,97,238,0.07),14,0,0,4);">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="📊  Reports"
                                       style="-fx-font-size: 14px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #1a1a2e;"
                                       HBox.hgrow="ALWAYS"/>
                                <Label fx:id="reportStatusLabel" text=""
                                       style="-fx-font-size: 11px;
                                              -fx-text-fill: #2dc653;"/>
                            </HBox>
                            <Separator/>

                            <Button text="📋  Issued Books"
                                    prefWidth="999" prefHeight="36"
                                    maxWidth="Infinity"
                                    styleClass="btn-primary"
                                    onAction="#downloadIssuedReport"/>
                            <Button text="⚠️  Overdue Report"
                                    prefWidth="999" prefHeight="36"
                                    maxWidth="Infinity"
                                    style="-fx-background-color: #fff0f1;
                                           -fx-text-fill: #e63946;
                                           -fx-font-weight: bold;
                                           -fx-font-size: 12px;
                                           -fx-background-radius: 6;
                                           -fx-cursor: hand;"
                                    onAction="#downloadOverdueReport"/>
                            <Button text="📚  Book Inventory"
                                    prefWidth="999" prefHeight="36"
                                    maxWidth="Infinity"
                                    style="-fx-background-color: #f0fff4;
                                           -fx-text-fill: #2dc653;
                                           -fx-font-weight: bold;
                                           -fx-font-size: 12px;
                                           -fx-background-radius: 6;
                                           -fx-cursor: hand;"
                                    onAction="#downloadInventoryReport"/>
                            <Button text="👥  Member List"
                                    prefWidth="999" prefHeight="36"
                                    maxWidth="Infinity"
                                    style="-fx-background-color: #fffbee;
                                           -fx-text-fill: #f77f00;
                                           -fx-font-weight: bold;
                                           -fx-font-size: 12px;
                                           -fx-background-radius: 6;
                                           -fx-cursor: hand;"
                                    onAction="#downloadMemberReport"/>
                            <Button text="📅  Monthly Summary"
                                    prefWidth="999" prefHeight="36"
                                    maxWidth="Infinity"
                                    style="-fx-background-color: #f5f0ff;
                                           -fx-text-fill: #7b2ff7;
                                           -fx-font-weight: bold;
                                           -fx-font-size: 12px;
                                           -fx-background-radius: 6;
                                           -fx-cursor: hand;"
                                    onAction="#downloadMonthlySummary"/>

                            <Label fx:id="reportPathLabel"
                                   text="📁 ~/LibraryApp/Reports/"
                                   style="-fx-font-size: 10px;
                                          -fx-text-fill: #c0c8e0;"/>
                        </VBox>
                    </HBox>

                    <!-- Footer -->
                    <Label text="The British College Library  •  v1.0.0  •  JavaFX + SQLite"
                           style="-fx-font-size: 11px; -fx-text-fill: #c0c8e0;"/>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>