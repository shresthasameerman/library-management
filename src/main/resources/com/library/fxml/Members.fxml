<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.library.controller.MemberController"
    spacing="20"
    style="-fx-padding: 30; -fx-background-color: #eef1fb;">

    <!-- ── HEADER ───────────────────────────────────────────────── -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="👥 Members Management"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;
                          -fx-text-fill: #1a1a2e;"/>
            <Label text="Register and manage The British College library members"
                   style="-fx-font-size: 13px; -fx-text-fill: #a0aec0;"/>
        </VBox>
        <Button text="➕  Register Member"
                styleClass="btn-primary"
                prefWidth="180" prefHeight="40"
                onAction="#handleAddMember"/>
    </HBox>

    <!-- ── FILTERS ROW ──────────────────────────────────────────── -->
    <HBox spacing="10" alignment="CENTER_LEFT">

        <!-- Search -->
        <TextField fx:id="searchField"
                   promptText="🔍  Search name, ID..."
                   styleClass="search-field"
                   prefWidth="220" prefHeight="40"
                   onKeyReleased="#handleSearch"/>

        <!-- Course Filter -->
        <ComboBox fx:id="courseFilter"
                  promptText="All Courses"
                  prefWidth="200" prefHeight="40"
                  onAction="#handleFilterChange"/>

        <!-- Intake Filter -->
        <ComboBox fx:id="intakeFilter"
                  promptText="All Intakes"
                  prefWidth="140" prefHeight="40"
                  onAction="#handleFilterChange"/>

        <!-- Type Filter -->
        <ComboBox fx:id="typeFilter"
                  promptText="All Types"
                  prefWidth="130" prefHeight="40"
                  onAction="#handleFilterChange"/>

        <!-- Show Inactive -->
        <CheckBox fx:id="showInactiveCheck"
                  text="Show Inactive"
                  style="-fx-font-size: 13px; -fx-text-fill: #4a5568;"
                  onAction="#handleFilterChange"/>

        <!-- Clear -->
        <Button text="✕ Clear"
                styleClass="btn-secondary"
                prefHeight="40"
                onAction="#handleClearSearch"/>

    </HBox>

    <!-- ── TABLE ────────────────────────────────────────────────── -->
    <TableView fx:id="membersTable"
               VBox.vgrow="ALWAYS"
               styleClass="table-view">
        <columns>
            <TableColumn fx:id="colId"
                         text="ID" prefWidth="50"/>
            <TableColumn fx:id="colMemberId"
                         text="Member ID" prefWidth="100"/>
            <TableColumn fx:id="colName"
                         text="Full Name" prefWidth="170"/>
            <TableColumn fx:id="colType"
                         text="Type" prefWidth="95"/>
            <TableColumn fx:id="colDepartment"
                         text="Course" prefWidth="180"/>
            <TableColumn fx:id="colIntake"
                         text="Intake" prefWidth="110"/>
            <TableColumn fx:id="colPhone"
                         text="Phone" prefWidth="110"/>
            <TableColumn fx:id="colStatus"
                         text="Status" prefWidth="75"/>
            <TableColumn fx:id="colActions"
                         text="Actions" prefWidth="190"/>
        </columns>
        <placeholder>
            <Label text="No members found."
                   style="-fx-text-fill: #a0aec0; -fx-font-size: 13px;"/>
        </placeholder>
    </TableView>

    <!-- ── STATUS BAR ───────────────────────────────────────────── -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label fx:id="statusLabel"
               text="Total: 0 member(s)"
               style="-fx-text-fill: #a0aec0; -fx-font-size: 12px;"/>
        <Label fx:id="filterInfoLabel"
               text=""
               style="-fx-text-fill: #4361ee; -fx-font-size: 12px;
                      -fx-font-weight: bold;"/>
    </HBox>

</VBox>