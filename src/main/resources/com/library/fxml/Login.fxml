<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<StackPane
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.library.controller.LoginController"
    prefWidth="900" prefHeight="600"
    style="-fx-background-color: #f0f2f5;">

    <!-- Centered Login Card -->
    <VBox
        styleClass="login-container"
        spacing="16"
        maxWidth="400"
        maxHeight="460"
        alignment="CENTER">

        <!-- Logo / Title -->
        <VBox alignment="CENTER" spacing="4">
            <Label text="📚 LibraryMS" styleClass="login-title"/>
            <Label text="Library Management System" styleClass="login-subtitle"/>
        </VBox>

        <!-- Spacer -->
        <Region prefHeight="10"/>

        <!-- Username -->
        <VBox spacing="6">
            <Label text="Username" styleClass="input-label"/>
            <TextField
                fx:id="usernameField"
                promptText="Enter your username"
                styleClass="text-input"
                prefWidth="280"/>
        </VBox>

        <!-- Password -->
        <VBox spacing="6">
            <Label text="Password" styleClass="input-label"/>
            <PasswordField
                fx:id="passwordField"
                promptText="Enter your password"
                styleClass="text-input"
                prefWidth="280"/>
        </VBox>

        <!-- Error Message -->
        <Label
            fx:id="errorLabel"
            text=""
            styleClass="error-label"
            wrapText="true"/>

        <!-- Spacer -->
        <Region prefHeight="6"/>

        <!-- Login Button -->
        <Button
            fx:id="loginButton"
            text="Login"
            styleClass="btn-primary"
            prefWidth="280"
            onAction="#handleLogin"/>

        <!-- Hint -->
        <Label
            text="Default: admin / admin123"
            styleClass="login-subtitle"
            style="-fx-font-size: 11px;"/>

    </VBox>
</StackPane>
