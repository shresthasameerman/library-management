<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.library.controller.StudentDashboardController"
            prefWidth="1100" prefHeight="680"
            style="-fx-background-color: #eef1fb;">

    <top>
        <VBox spacing="16" style="-fx-padding: 24 26 12 26;">
            <HBox alignment="CENTER_LEFT" spacing="12"
                  style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 18 22 18 22;">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="🎓 Student Portal"
                           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    <Label text="Track your issued books, due dates, and borrowing history"
                           style="-fx-font-size: 12px; -fx-text-fill: #7c8db5;"/>
                </VBox>
                <Button text="🔄 Refresh" onAction="#handleRefresh"
                        style="-fx-background-color: #eef1fb; -fx-text-fill: #4361ee; -fx-font-weight: bold; -fx-background-radius: 8;"/>
                <Button text="🚪 Logout" onAction="#handleLogout"
                        style="-fx-background-color: #fff0f1; -fx-text-fill: #e63946; -fx-font-weight: bold; -fx-background-radius: 8;"/>
            </HBox>

            <HBox spacing="14">
                <VBox HBox.hgrow="ALWAYS" spacing="6"
                      style="-fx-background-color: #4361ee; -fx-background-radius: 16; -fx-padding: 20;">
                    <Label text="Welcome Back"
                           style="-fx-text-fill: rgba(255,255,255,0.75); -fx-font-size: 11px; -fx-font-weight: bold;"/>
                    <Label fx:id="welcomeLabel" text="Student"
                           style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                    <Label text="Your library activity in one place"
                           style="-fx-text-fill: rgba(255,255,255,0.65); -fx-font-size: 12px;"/>
                </VBox>

                <VBox spacing="4" prefWidth="220"
                      style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 18;">
                    <Label text="Member ID" style="-fx-text-fill: #7c8db5; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                    <Label fx:id="memberIdLabel" text="-"
                           style="-fx-text-fill: #1a1a2e; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <Label fx:id="statusLabel" text="Active"
                           style="-fx-text-fill: #2dc653; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #eef1fb; -fx-background: #eef1fb;">
            <content>
                <VBox spacing="18" style="-fx-padding: 0 26 26 26; -fx-background-color: #eef1fb;">

                    <HBox spacing="14">
                        <VBox HBox.hgrow="ALWAYS" spacing="6"
                              style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 18;">
                            <Label text="Currently Issued" style="-fx-text-fill: #7c8db5; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                            <Label fx:id="issuedCountLabel" text="0"
                                   style="-fx-text-fill: #1a1a2e; -fx-font-size: 32px; -fx-font-weight: bold;"/>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" spacing="6"
                              style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 18;">
                            <Label text="Borrowing History" style="-fx-text-fill: #7c8db5; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                            <Label fx:id="historyCountLabel" text="0"
                                   style="-fx-text-fill: #1a1a2e; -fx-font-size: 32px; -fx-font-weight: bold;"/>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" spacing="6"
                              style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 18;">
                            <Label text="Next Due Date" style="-fx-text-fill: #7c8db5; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                            <Label fx:id="nextDueLabel" text="-"
                                   style="-fx-text-fill: #e63946; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" spacing="6"
                              style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 18;">
                            <Label text="Overdue Items" style="-fx-text-fill: #7c8db5; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                            <Label fx:id="overdueCountLabel" text="0"
                                   style="-fx-text-fill: #e63946; -fx-font-size: 32px; -fx-font-weight: bold;"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="14">
                        <VBox HBox.hgrow="ALWAYS" spacing="6"
                              style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 18;">
                            <Label text="Course / Department" style="-fx-text-fill: #7c8db5; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                            <Label fx:id="courseLabel" text="-" style="-fx-text-fill: #1a1a2e; -fx-font-size: 15px; -fx-font-weight: bold;"/>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" spacing="6"
                              style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 18;">
                            <Label text="Intake" style="-fx-text-fill: #7c8db5; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                            <Label fx:id="intakeLabel" text="-" style="-fx-text-fill: #1a1a2e; -fx-font-size: 15px; -fx-font-weight: bold;"/>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" spacing="6"
                              style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 18;">
                            <Label text="Estimated Fine Today" style="-fx-text-fill: #7c8db5; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                            <Label fx:id="fineEstimateLabel" text="Rs. 0"
                                   style="-fx-text-fill: #4361ee; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20;">
                        <Label text="Issued Books"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        <FlowPane fx:id="currentBooksPane" hgap="14" vgap="14" prefWrapLength="1000"/>
                    </VBox>

                    <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20;">
                        <Label text="Issue History"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        <TableView fx:id="historyTable" prefHeight="260">
                            <columns>
                                <TableColumn fx:id="historyBookColumn" text="Book Title" prefWidth="230"/>
                                <TableColumn fx:id="historyAccessionColumn" text="Accession" prefWidth="120"/>
                                <TableColumn fx:id="historyIssueDateColumn" text="Issued" prefWidth="100"/>
                                <TableColumn fx:id="historyDueDateColumn" text="Due Date" prefWidth="100"/>
                                <TableColumn fx:id="historyReturnDateColumn" text="Returned" prefWidth="100"/>
                                <TableColumn fx:id="historyFineColumn" text="Fine" prefWidth="90"/>
                            </columns>
                            <placeholder>
                                <Label text="No returned books yet." style="-fx-text-fill: #a0aec0;"/>
                            </placeholder>
                        </TableView>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>