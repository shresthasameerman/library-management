<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.library.controller.BookController"
    spacing="20"
    style="-fx-padding: 30; -fx-background-color: #eef1fb;">

    <!-- ── HEADER ───────────────────────────────────────────────── -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="📖 Books Management"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;
                          -fx-text-fill: #1a1a2e;"/>
            <Label text="Manage your library collection"
                   style="-fx-font-size: 13px; -fx-text-fill: #a0aec0;"/>
        </VBox>
        <Button text="➕  Add New Book"
                styleClass="btn-primary"
                prefWidth="160" prefHeight="40"
                onAction="#handleAddBook"/>
    </HBox>

    <!-- ── SEARCH + FILTER ──────────────────────────────────────── -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="searchField"
                   promptText="🔍  Search title, author, ISBN, accession, class no..."
                   styleClass="search-field"
                   prefWidth="400" prefHeight="40"
                   onKeyReleased="#handleSearch"/>
        <ComboBox fx:id="categoryFilter"
                  promptText="All Categories"
                  prefWidth="180" prefHeight="40"
                  onAction="#handleCategoryFilter"/>
        <Button text="✕ Clear"
                styleClass="btn-secondary"
                prefHeight="40"
                onAction="#handleClearSearch"/>
    </HBox>

    <!-- ── TABLE ────────────────────────────────────────────────── -->
    <TableView fx:id="booksTable"
               VBox.vgrow="ALWAYS"
               styleClass="table-view">
        <columns>
            <TableColumn fx:id="colId"
                         text="ID" prefWidth="45"/>
            <TableColumn fx:id="colAccession"
                         text="Accession No." prefWidth="120"/>
            <TableColumn fx:id="colTitle"
                         text="Title" prefWidth="200"/>
            <TableColumn fx:id="colAuthor"
                         text="Author" prefWidth="140"/>
            <TableColumn fx:id="colClassification"
                         text="Class No." prefWidth="100"/>
            <TableColumn fx:id="colCategory"
                         text="Category" prefWidth="100"/>
            <TableColumn fx:id="colTotal"
                         text="Total" prefWidth="55"/>
            <TableColumn fx:id="colAvailable"
                         text="Avail." prefWidth="55"/>
            <TableColumn fx:id="colActions"
                         text="Actions" prefWidth="180"/>
        </columns>
        <placeholder>
            <Label text="No books found. Click '➕ Add New Book' to get started."
                   style="-fx-text-fill: #a0aec0; -fx-font-size: 13px;"/>
        </placeholder>
    </TableView>

    <!-- ── STATUS ───────────────────────────────────────────────── -->
    <Label fx:id="statusLabel"
           text="Total: 0 books"
           style="-fx-text-fill: #a0aec0; -fx-font-size: 12px;"/>

</VBox>