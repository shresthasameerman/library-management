<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.library.controller.SuperAdminDashboardController" styleClass="superadmin-root">
    <left>
        <VBox fx:id="sidebar" prefWidth="250" styleClass="sidebar">
            <Label text="LibraryMS" styleClass="app-logo" />
            <Label text="SuperAdmin Control Center" styleClass="app-subtitle" />
            <Separator />
            <Label text="NAVIGATION" styleClass="sidebar-section" />

            <Button fx:id="menuDashboard" onAction="#showDashboard" styleClass="sidebar-item sidebar-item-active" text="▦  Dashboard" />
            <Button fx:id="menuIssueReturn" onAction="#showIssueReturn" styleClass="sidebar-item" text="⇄  Issue/Return" />
            <Button fx:id="menuBranchAnalytics" onAction="#showBranchAnalytics" styleClass="sidebar-item" text="◔  Branch Analytics" />
            <Button fx:id="menuUserManagement" onAction="#showUserManagement" styleClass="sidebar-item" text="◉  User Management" />
            <Button fx:id="menuBranchManagement" onAction="#showBranchManagement" styleClass="sidebar-item" text="▣  Branch Management" />
            <Button fx:id="menuReports" onAction="#showReports" styleClass="sidebar-item" text="▤  Reports" />
            <Button fx:id="menuSystemManagement" onAction="#showSystemManagement" styleClass="sidebar-item" text="⚙  System Management" />
            <Button fx:id="menuNotifications" onAction="#showNotifications" styleClass="sidebar-item" text="◌  Notifications" />

            <Region VBox.vgrow="ALWAYS" />
            <Label fx:id="loggedInUserLabel" styleClass="user-badge" text="superadmin" />
        </VBox>
    </left>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="top-header">
            <VBox spacing="2">
                <Label fx:id="pageTitleLabel" styleClass="page-title" text="Dashboard" />
                <Label fx:id="pageSubtitleLabel" styleClass="page-subtitle" text="System-wide insights across all branches" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#refreshAllData" styleClass="ghost-btn" text="Refresh" />
            <Button onAction="#logout" styleClass="primary-btn" text="Logout" />
        </HBox>
    </top>

    <center>
        <StackPane>
            <StackPane fx:id="mainContentPane">
                <StackPane fx:id="dashboardPane" styleClass="content-wrap" visible="true" managed="true">
                    <VBox>
                    <GridPane hgap="12" vgap="12">
                        <HBox styleClass="stat-card" spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label styleClass="stat-icon" text="📚" />
                            <VBox>
                                <Label styleClass="stat-label" text="Total Books" />
                                <Label fx:id="totalBooksValueLabel" styleClass="stat-value" text="0" />
                            </VBox>
                        </HBox>

                        <HBox styleClass="stat-card" spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label styleClass="stat-icon good" text="✅" />
                            <VBox>
                                <Label styleClass="stat-label" text="Books Available" />
                                <Label fx:id="booksAvailableValueLabel" styleClass="stat-value" text="0" />
                            </VBox>
                        </HBox>

                        <HBox styleClass="stat-card" spacing="10" GridPane.columnIndex="2" GridPane.rowIndex="0">
                            <Label styleClass="stat-icon" text="👥" />
                            <VBox>
                                <Label styleClass="stat-label" text="Total Members" />
                                <Label fx:id="totalMembersValueLabel" styleClass="stat-value" text="0" />
                            </VBox>
                        </HBox>

                        <HBox styleClass="stat-card" spacing="10" GridPane.columnIndex="3" GridPane.rowIndex="0">
                            <Label styleClass="stat-icon" text="📖" />
                            <VBox>
                                <Label styleClass="stat-label" text="Active Issues" />
                                <Label fx:id="activeIssuesValueLabel" styleClass="stat-value" text="0" />
                            </VBox>
                        </HBox>

                        <HBox styleClass="stat-card" spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label styleClass="stat-icon bad" text="⚠" />
                            <VBox>
                                <Label styleClass="stat-label" text="Overdue Books" />
                                <Label fx:id="overdueBooksValueLabel" styleClass="stat-value bad" text="0" />
                            </VBox>
                        </HBox>

                        <HBox styleClass="stat-card" spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label styleClass="stat-icon warn" text="₹" />
                            <VBox>
                                <Label styleClass="stat-label" text="Total Fines" />
                                <Label fx:id="totalFinesValueLabel" styleClass="stat-value warn" text="0" />
                            </VBox>
                        </HBox>

                        <HBox styleClass="stat-card" spacing="10" GridPane.columnIndex="2" GridPane.rowIndex="1">
                            <Label styleClass="stat-icon" text="▣" />
                            <VBox>
                                <Label styleClass="stat-label" text="Total Branches" />
                                <Label fx:id="totalBranchesValueLabel" styleClass="stat-value" text="0" />
                            </VBox>
                        </HBox>

                        <HBox styleClass="stat-card" spacing="10" GridPane.columnIndex="3" GridPane.rowIndex="1">
                            <Label styleClass="stat-icon" text="🧑" />
                            <VBox>
                                <Label styleClass="stat-label" text="Total Users/Staff" />
                                <Label fx:id="totalUsersValueLabel" styleClass="stat-value" text="0" />
                            </VBox>
                        </HBox>
                    </GridPane>

                    <VBox styleClass="card" spacing="8">
                        <Label styleClass="card-title" text="Overview" />
                        <Label styleClass="card-muted" text="This dashboard shows live system-level data across all branches." />
                    </VBox>
                    </VBox>
                </StackPane>

                <StackPane fx:id="issueReturnPane" styleClass="content-wrap" visible="false" managed="false">
                    <VBox VBox.vgrow="ALWAYS">
                    <VBox styleClass="card" spacing="10" VBox.vgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label styleClass="card-title" text="Issue/Return Records" />
                            <Region HBox.hgrow="ALWAYS" />
                            <TextField fx:id="issueSearchField" promptText="Search accession, title, member..." styleClass="search-input" prefWidth="280" />
                            <ComboBox fx:id="issueBranchFilterCombo" prefWidth="190" />
                            <Button onAction="#applyIssueFilters" styleClass="ghost-btn" text="Filter" />
                            <Button onAction="#resetIssueFilters" styleClass="ghost-btn" text="Reset" />
                        </HBox>

                        <TableView fx:id="issueReturnTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="accessionColumn" text="Accession" prefWidth="120" />
                                <TableColumn fx:id="bookTitleColumn" text="Book Title" prefWidth="220" />
                                <TableColumn fx:id="memberNameColumn" text="Member" prefWidth="170" />
                                <TableColumn fx:id="branchNameColumn" text="Branch" prefWidth="140" />
                                <TableColumn fx:id="issueDateColumn" text="Issue Date" prefWidth="120" />
                                <TableColumn fx:id="dueDateColumn" text="Due Date" prefWidth="120" />
                                <TableColumn fx:id="returnDateColumn" text="Return Date" prefWidth="130" />
                                <TableColumn fx:id="fineAmountColumn" text="Fine" prefWidth="100" />
                                <TableColumn fx:id="statusColumn" text="Status" prefWidth="120" />
                            </columns>
                        </TableView>

                        <HBox spacing="10" alignment="CENTER_RIGHT">
                            <Label fx:id="issueEmptyLabel" styleClass="empty-note" text="" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button onAction="#exportCsv" styleClass="ghost-btn" text="Export CSV" />
                            <Button onAction="#exportPdf" styleClass="ghost-btn" text="Export PDF" />
                            <Button onAction="#printIssueTable" styleClass="primary-btn" text="Print" />
                        </HBox>
                    </VBox>
                    </VBox>
                </StackPane>

                <StackPane fx:id="branchAnalyticsPane" styleClass="content-wrap" visible="false" managed="false" />
                <StackPane fx:id="userManagementPane" styleClass="content-wrap" visible="false" managed="false" />
                <StackPane fx:id="branchManagementPane" styleClass="content-wrap" visible="false" managed="false" />
                <StackPane fx:id="reportsPane" styleClass="content-wrap" visible="false" managed="false" />
                <StackPane fx:id="systemManagementPane" styleClass="content-wrap" visible="false" managed="false" />
                <StackPane fx:id="notificationsPane" styleClass="content-wrap" visible="false" managed="false" />
            </StackPane>

            <ProgressIndicator fx:id="loadingIndicator" visible="false" managed="false" />
        </StackPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="footer-status">
            <Label fx:id="lastUpdatedLabel" text="Last Updated: --" />
            <Separator orientation="VERTICAL" />
            <Label fx:id="statusLabel" text="Ready" />
        </HBox>
    </bottom>
</BorderPane>
