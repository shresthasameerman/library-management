<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.library.controller.BookController"
    spacing="20"
    style="-fx-padding: 30; -fx-background-color: #f0f2f5;">

    <!-- ── HEADER ROW ───────────────────────────────────────────── -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <Label text="📖 Books Management"
               styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="➕  Add New Book"
                styleClass="btn-primary"
                prefWidth="160" prefHeight="38"
                onAction="#handleAddBook"/>
    </HBox>

    <!-- ── SEARCH + FILTER ROW ──────────────────────────────────── -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField
            fx:id="searchField"
            promptText="🔍  Search by title, author, ISBN, category..."
            styleClass="search-field"
            prefWidth="380"
            onKeyReleased="#handleSearch"/>

        <ComboBox
            fx:id="categoryFilter"
            promptText="All Categories"
            prefWidth="180"
            prefHeight="38"
            onAction="#handleCategoryFilter"/>

        <Button text="Clear"
                styleClass="btn-secondary"
                prefHeight="38"
                onAction="#handleClearSearch"/>
    </HBox>

    <!-- ── BOOKS TABLE ──────────────────────────────────────────── -->
    <TableView
        fx:id="booksTable"
        VBox.vgrow="ALWAYS"
        styleClass="table-view"
        style="-fx-pref-height: 420px;">

        <columns>
            <TableColumn fx:id="colId"
                         text="ID" prefWidth="50"/>
            <TableColumn fx:id="colTitle"
                         text="Title" prefWidth="220"/>
            <TableColumn fx:id="colAuthor"
                         text="Author" prefWidth="160"/>
            <TableColumn fx:id="colIsbn"
                         text="ISBN" prefWidth="120"/>
            <TableColumn fx:id="colCategory"
                         text="Category" prefWidth="120"/>
            <TableColumn fx:id="colTotal"
                         text="Total" prefWidth="60"/>
            <TableColumn fx:id="colAvailable"
                         text="Available" prefWidth="80"/>
            <TableColumn fx:id="colActions"
                         text="Actions" prefWidth="150"/>
        </columns>

        <placeholder>
            <Label text="No books found. Click '➕ Add New Book' to get started."
                   style="-fx-text-fill: #888888; -fx-font-size: 13px;"/>
        </placeholder>
    </TableView>

    <!-- ── BOTTOM STATUS ROW ────────────────────────────────────── -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label fx:id="statusLabel"
               text="Total: 0 books"
               style="-fx-text-fill: #888888; -fx-font-size: 12px;"/>
    </HBox>

</VBox>
